{
	"name": "dnd-obelisk-stats",
	"version": "1.0.0",
	"description": "Plugin for displaying DnD character stats",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"npm run css:watch\" \"node esbuild.config.mjs\"",
		"build": "tsc -noEmit -skipLibCheck && npm run css:build && node esbuild.config.mjs production",
		"css:build": "tailwindcss -i ./src/styles.css -o ./styles.css --minify",
		"css:watch": "tailwindcss -i ./src/styles.css -o ./styles.css --watch",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^22.15.17",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^10.0.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"deepmerge": "^4.3.1",
		"expr-eval": "^2.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
